[Unit]
Description=Lessons in shelter — сторінка для дітей
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/lessonsinshelter/web
ExecStart=/usr/bin/python3 -m http.server 8080 --directory /opt/lessonsinshelter/web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
